-- 데이터 확인 쿼리
SELECT COUNT(*) as total_users FROM users WHERE user_id > 1;
SELECT 
    CASE 
        WHEN u.user_id BETWEEN 2 AND 13 THEN 'Backend'
        WHEN u.user_id BETWEEN 14 AND 25 THEN 'Frontend'  
        WHEN u.user_id BETWEEN 26 AND 33 THEN 'Mobile'
        WHEN u.user_id BETWEEN 34 AND 41 THEN 'DevOps'
        WHEN u.user_id BETWEEN 42 AND 47 THEN 'AI/ML'
        WHEN u.user_id BETWEEN 48 AND 51 THEN 'Full Stack'
    END as tech_part,
    COUNT(*) as count
FROM users u 
WHERE u.user_id > 1
GROUP BY 
    CASE 
        WHEN u.user_id BETWEEN 2 AND 13 THEN 'Backend'
        WHEN u.user_id BETWEEN 14 AND 25 THEN 'Frontend'
        WHEN u.user_id BETWEEN 26 AND 33 THEN 'Mobile'
        WHEN u.user_id BETWEEN 34 AND 41 THEN 'DevOps'
        WHEN u.user_id BETWEEN 42 AND 47 THEN 'AI/ML'
        WHEN u.user_id BETWEEN 48 AND 51 THEN 'Full Stack'
    END;

-- 기술 스택별 사용자 수 확인
SELECT ts.name as tech_name, COUNT(uts.user_id) as user_count
FROM tech_stack ts
LEFT JOIN user_tech_stack uts ON ts.tech_stack_id = uts.tech_stack_id
WHERE uts.user_id > 1 OR uts.user_id IS NULL
GROUP BY ts.tech_stack_id, ts.name
HAVING COUNT(uts.user_id) > 0
ORDER BY user_count DESC;